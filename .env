# Corvin environment variables — local development
# DO NOT COMMIT this file.

# ── Runtime environment ──────────────────────────────────────────────────────
CORVIN_ENV=local

# ── Database backend ────────────────────────────────────────────────────────
# Set to 'sqlite' when on org WiFi where Azure Postgres is unreachable.
# SQLite stores data in ./corvin.db — no Alembic migrations needed.
# Set to 'postgres' (default) for normal cloud-connected development.
DB_BACKEND=sqlite
CORVIN_SQLITE_PATH=./corvin.db

# ── Postgres ─────────────────────────────────────────────────────────────────
CORVIN_DB_HOST=synaptic-postgres-db.postgres.database.azure.com
CORVIN_DB_PORT=5432
CORVIN_DB_NAME=postgres
CORVIN_DB_USER=synapticneuron
CORVIN_DB_PASSWORD=Admin1234

# ── LLM — Azure OpenAI (via LiteLLM azure/ prefix) ──────────────────────────
LITELLM_ENDPOINT=https://synaptic.openai.azure.com/
LITELLM_API_KEY=3DKzV6AYf2DmWMzPMFiUOtEVE5lX2D1zwa7Gv2OZBpIgPqeZzxDmJQQJ99CDACYeBjFXJ3w3AAAAACOGkkVA
AZURE_API_VERSION=2025-04-01-preview

# ── Azure AI Foundry project endpoint (for future Agents use) ────────────────
AZURE_AI_FOUNDRY_ENDPOINT=https://synaptic.services.ai.azure.com/api/projects/synaptic-project

# ── Elastic ──────────────────────────────────────────────────────────────────
ELASTIC_HOST=https://your-elastic-host:9200
ELASTIC_API_KEY=placeholder

