{
  "entries": [
    {
      "keyword": "apim-5xx",
      "title": "APIM 5xx Spike Investigation",
      "file": "runbooks/apim-5xx.md",
      "match_patterns": ["apim", "5xx", "gateway", "apimanagement", "api management"]
    },
    {
      "keyword": "aks-crashloop",
      "title": "AKS Pod CrashLoopBackOff Investigation",
      "file": "runbooks/aks-crashloop.md",
      "match_patterns": ["crashloop", "crashloopbackoff", "pod", "oomkilled", "restart", "crash"]
    },
    {
      "keyword": "chad-api-spec",
      "title": "CHAD API Endpoint Specification & APIM Policy Reference",
      "file": "runbooks/chad-api-spec.md",
      "match_patterns": [
        "FundController", "PartnerController", "PostbackController",
        "MemberProfileController", "FundIntegrationController",
        "ProxyAuditLogController", "CacheManagementController", "PartnerFundController",
        "/b2bservice/v1/schemes/", "/chadservice/v1/schemes/",
        "/v1/schemes/axe/health-check/all", "/internal/cache/evict/partner-configs",
        "amended_insurance", "validate-jwt", "X-CorrelationId",
        "X-Internal-Debug-Key", "X-CHAD-Request-ID",
        "fundCode", "scheme_reference", "member_uuid",
        "IP_NOT_ALLOWED", "IPV6_NOT_SUPPORTED", "PAYLOAD_TOO_LARGE", "QUOTA_EXCEEDED"
      ]
    },
    {
      "keyword": "chad-dependencies",
      "title": "CHAD Upstream & Downstream Dependency Map",
      "file": "runbooks/chad-dependencies.md",
      "match_patterns": [
        "cdb14470aepr0101", "cdb14470aedv0101", "kyv14470aepr0101", "kyv14470aedv0101",
        "FundRequest", "MemberProfile", "Postback", "PartnerConfigs",
        "PartnerConfigsHistory", "ProxyAuditLog", "PolicyConfigRepository",
        "PostbackRepository", "MemberProfileRepository", "RequestRepository",
        "azure-cosmos-key", "ping-referanceid-uname", "ping-referanceid-pwd",
        "auth.asia.metlife.com", "RefIDChadAU", "FundApisCallInterceptor",
        "elastic-agent-otlp", "StaticProps", "spring-cloud-azure-starter-data-cosmos"
      ]
    },
    {
      "keyword": "chad-known-errors",
      "title": "CHAD Known Application Errors & Exception Reference",
      "file": "runbooks/chad-known-errors.md",
      "match_patterns": [
        "CosmosException", "XSDFileNameException", "XMLValidationException",
        "MemberNotFoundException", "ResourceNotFoundException",
        "BusinessValidationException", "PartnerConfigNotFoundException",
        "MissingRequestHeaderException", "GlobalExceptionHandler",
        "MISSING_HEADER", "CONFIG_NOT_FOUND", "MEMBER_UUID_NOT_FOUND", "GENERAL_ERROR",
        "BusinessValidationErrorResponse", "ProblemDetails",
        "Cosmos DB error occurred: Status=", "Unexpected error occurred:",
        "Reference value not returned from PingFederate",
        "Error processing member information",
        "Error saving member profile to fundapis for fundCode:",
        "Error getting member profile from fundapis for fundCode:",
        "Error fetching member info", "Member information not found for ID:",
        "Error retrieving member data:", "Error saving postback:",
        "Error during cache eviction", "Member service error - memberHash:"
      ]
    },
    {
      "keyword": "chad-service-topology",
      "title": "CHAD AKS Deployment Topology & Scaling Configuration",
      "file": "runbooks/chad-service-topology.md",
      "match_patterns": [
        "chad-fundapis", "chad-partnerapis", "chad-fundsso",
        "chad-fundapis-hpa", "chad-partnerapis-hpa", "chad-fundsso-hpa",
        "acr14470aepr011", "chad-shared-gateway", "chad-sa",
        "sidecar.istio.io/inject", "azure.workload.identity/use",
        "channels.metlife.com.au", "elastic-agent-otlp",
        "autoscaling/v2", "/actuator/health/readiness", "/actuator/health/liveness",
        "project=chad", "service=fundapis", "service=partnerapis", "service=fundsso"
      ]
    },
    {
      "keyword": "chad-service-inventory",
      "title": "CHAD Service Inventory & Inter-Service Call Graph",
      "file": "runbooks/chad-service-inventory.md",
      "match_patterns": [
        "FundApiApplication", "PartnerApiApplication", "FundIntegrationApplication",
        "FundApisCallInterceptor", "MemberProfileService", "APIUtils", "SSOUtils",
        "au.com.metlife.channel", "au.com.metlife.fundapi",
        "microservices.member-service.url", "microservices.fundapis.url",
        "health.check.fundsso.url", "health.check.timeout",
        "Failed to save member profile:", "Failed to get member profile:"
      ]
    },
    {
      "keyword": "chad-security-context",
      "title": "CHAD Security, Authentication & Observability Context",
      "file": "runbooks/chad-security-context.md",
      "match_patterns": [
        "unauthorized", "401", "403", "forbidden", "validate-jwt", "Bearer",
        "IP_NOT_ALLOWED", "IPV6_NOT_SUPPORTED", "QUOTA_EXCEEDED",
        "workload-identity", "DefaultAzureCredential",
        "CredentialUnavailableException", "ClientAuthenticationException",
        "kyv14470aepr0101", "chad-sa",
        "94148a30-8d1b-4c56-8e50-84d50ebbdac1",
        "ca56a4a5-e300-406a-98ff-7e36a0baac5b",
        "elastic-agent-otlp", "opentelemetry-javaagent",
        "traceparent", "X-CHAD-Request-ID", "apim_request_id"
      ]
    }
  ]
}
