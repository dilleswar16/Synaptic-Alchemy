# Corvin environment variables
# Copy this file to .env and fill in values for local development.
# Never commit .env with real secrets.

# ── Runtime environment ──────────────────────────────────────────────────────
CORVIN_ENV=local

# ── Database backend ────────────────────────────────────────────────────────
# 'postgres' = Azure Postgres (default). 'sqlite' = local file, no network needed.
DB_BACKEND=postgres
# CORVIN_SQLITE_PATH=./corvin.db   # override SQLite file location if needed

# ── Postgres ─────────────────────────────────────────────────────────────────
CORVIN_DB_HOST=localhost
CORVIN_DB_PORT=5432
CORVIN_DB_NAME=corvin
CORVIN_DB_USER=corvin
CORVIN_DB_PASSWORD=changeme

# ── LLM (LiteLLM) ────────────────────────────────────────────────────────────
LITELLM_API_KEY=sk-placeholder
LITELLM_ENDPOINT=https://api.openai.com/v1

# ── Elastic ──────────────────────────────────────────────────────────────────
ELASTIC_HOST=https://your-elastic-host:9200
ELASTIC_API_KEY=placeholder

# ── Azure Log Analytics ──────────────────────────────────────────────────────
LOG_ANALYTICS_WORKSPACE_ID=placeholder
AZURE_CLIENT_ID=placeholder
AZURE_CLIENT_SECRET=placeholder
AZURE_TENANT_ID=placeholder

# ── Azure subscription ───────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=placeholder

# ── Azure Alerts webhook ─────────────────────────────────────────────────────
AZURE_ALERTS_WEBHOOK_SECRET=placeholder

# ── Teams ─────────────────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://placeholder.webhook.office.com/webhookb2/placeholder
CORVIN_WEB_BASE_URL=http://localhost:5173
CORVIN_ALLOWED_ORIGINS=http://localhost:5173

# ── Teams Bot (V2 ChatOps) ────────────────────────────────────────────────────
# Set bot_enabled: true in config/integrations/teams.yaml once registered.
TEAMS_APP_ID=placeholder
TEAMS_APP_PASSWORD=placeholder

# ── RCA Email Notifications ───────────────────────────────────────────────────
# Optional: enable config/integrations/email.yaml to auto-send RCA PDFs.
CORVIN_SMTP_HOST=smtp.office365.com
CORVIN_SMTP_USERNAME=placeholder
CORVIN_SMTP_PASSWORD=placeholder
CORVIN_EMAIL_FROM=corvin@yourcompany.com
# Comma-separated recipient list
CORVIN_EMAIL_TO=sre@yourcompany.com

https://portal.azure.com/457bc2c0-610b-4bf1-b615-b8621ee51c31
