# ───────────────────────────────────────────────────────────────────────────────
# Keigan backend configuration. Copy to .env and adjust. Every key maps to keigan/config/settings.py.
# ───────────────────────────────────────────────────────────────────────────────

# Runtime: local | dev | test | prod
# AUTH_MODE=local (anyone can sign in as any demo user) and the default development secrets are only accepted when
# ENVIRONMENT is local or test (test is the automated test suite). dev and prod refuse to start with them.
ENVIRONMENT=local
LOG_LEVEL=INFO
RUN_WORKERS_IN_PROCESS=true
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database: SQLite locally; Azure SQL in Azure (PostgreSQL also works: postgresql+asyncpg://user:password@host:5432/keigan)
# DATABASE_URL=sqlite+aiosqlite:///./data/keigan.db
# Azure SQL (pip install -e ".[azuresql]" + ODBC Driver 18; tables from database/azure_sql/run_all.sql):
# DATABASE_URL=mssql+aioodbc://@<server>.database.windows.net:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
# DATABASE_SCHEMA=keigan
# connection_string (user/password inside DATABASE_URL) | managed_identity (Keigan's Entra token; no password)
# DATABASE_AUTHENTICATION=managed_identity
# Create tables at start-up (local only; false in Azure where the SQL scripts / migrations own the schema)
AUTO_CREATE_SCHEMA=true

# ── Authentication ─────────────────────────────────────────────────────────────
# AUTH_MODE=local uses dummy users from keigan/resources/local_users.yaml. AUTH_MODE=entra uses Microsoft Entra ID (MSAL).
AUTH_MODE=local
# Signs local sign-in tokens. Outside ENVIRONMENT=local/test the built-in default is refused and the value must be random.
LOCAL_TOKEN_SIGNING_SECRET=change-me-to-a-long-random-string-for-local-use-only
# Shortest accepted LOCAL_TOKEN_SIGNING_SECRET and LOCAL_SECRET_ENCRYPTION_KEY outside ENVIRONMENT=local/test
SECRET_MINIMUM_LENGTH=32
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=
# Delegated scope a user token must carry in its "scp" claim (empty: the last part of ENTRA_API_SCOPE, e.g. access_as_user)
ENTRA_REQUIRED_DELEGATED_SCOPE=
# Comma-separated Entra app roles allowed to call the API without a user (service principals). Empty: app-only tokens are refused.
ENTRA_ALLOWED_APP_ROLES=
KEIGAN_ADMIN_GROUP_NAME=KEIGAN_admin
KEIGAN_ADMIN_GROUP_OBJECT_ID=
APPLICATION_ADMIN_GROUP_PATTERN={application_code}_admin
APPLICATION_READER_GROUP_PATTERN={application_code}_reader

# ── Keigan's Azure identity (shown to application teams on the "Grant access" step) ──
# In Azure leave the IDs empty: Keigan reads tenant, client and object ID from its own access token.
# The values below are local placeholders so the screen has something to show without Azure.
# managed_identity | workload_identity | client_secret | azure_cli | none
AZURE_IDENTITY_MODE=none
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
KEIGAN_MANAGED_IDENTITY_OBJECT_ID=11111111-2222-3333-4444-555555555555
KEIGAN_MANAGED_IDENTITY_CLIENT_ID=66666666-7777-8888-9999-000000000000
KEIGAN_MANAGED_IDENTITY_DISPLAY_NAME=id-keigan-local
KEIGAN_MULTI_TENANT_APP_CLIENT_ID=

# ── Integration modes: live | simulated | disabled (email: graph | smtp | simulated | disabled) ──
TELEMETRY_MODE=simulated
SERVICENOW_MODE=simulated
TEAMS_MODE=simulated
EMAIL_MODE=simulated

# ServiceNow
SERVICENOW_INSTANCE_URL=
SERVICENOW_AUTH_METHOD=oauth
SERVICENOW_CLIENT_ID=
SERVICENOW_USERNAME=
SERVICENOW_CREDENTIAL_SECRET_NAME=servicenow-credential
SERVICENOW_POLL_INTERVAL_SECONDS=60

# Microsoft Graph, Teams, email
GRAPH_SENDER_MAILBOX=keigan@metlife.example
EMAIL_FROM_ADDRESS=keigan@metlife.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD_SECRET_NAME=smtp-password
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_SECRET_NAME=teams-bot-secret
TEAMS_APP_CATALOG_ID=
# Comma-separated host patterns (* wildcard) a Teams activity serviceUrl must match before Keigan sends its bot token there
BOT_FRAMEWORK_SERVICE_URL_HOST_PATTERNS=*.botframework.com,smba.trafficmanager.net
TEAMS_CHAT_POLL_INTERVAL_MINUTES=5
TEAMS_MILESTONE_PHRASES=keigan, this is finished|keigan this is finished|keigan, resolved|keigan resolved|keigan, incident closed|keigan, we are done

# ── AI ─────────────────────────────────────────────────────────────────────────
# gemini | azure_openai | openai_compatible | anthropic | mock   (mock = offline placeholder answers, no key needed)
LLM_PROVIDER=mock
LLM_API_KEY=
# Azure OpenAI endpoint or OpenAI-compatible base URL (e.g. MetLife's internal wrapper)
LLM_BASE_URL=
LLM_API_VERSION=2024-10-21
# Extra headers for corporate gateways, e.g. {"Ocp-Apim-Subscription-Key":"..."}
LLM_EXTRA_HEADERS_JSON={}
LLM_USE_MANAGED_IDENTITY=false
# Token scope requested for the managed identity (azure_openai and openai_compatible)
LLM_MANAGED_IDENTITY_SCOPE=https://cognitiveservices.azure.com/.default
# Model (or Azure deployment) names per tier
LLM_FAST_MODEL=gemini-2.5-flash
LLM_DEEP_MODEL=gemini-2.5-pro
LLM_VISION_MODEL=gemini-2.5-flash
# Set to -1 for models that reject a temperature parameter
LLM_TEMPERATURE=0.1
# function_calling | json_schema | json_mode
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENT_REQUESTS=8
LLM_DAILY_TOKEN_BUDGET_PER_APPLICATION=3000000
LLM_PRICE_PER_MILLION_INPUT_TOKENS=1.25
LLM_PRICE_PER_MILLION_OUTPUT_TOKENS=10.0

# ── Investigations ─────────────────────────────────────────────────────────────
INVESTIGATION_LOOKBACK_MINUTES=60
INVESTIGATION_MAX_WINDOW_MINUTES=240
INVESTIGATION_MAX_CONCURRENT=3
INVESTIGATION_EVIDENCE_TOKEN_BUDGET=8000
INVESTIGATION_KNOWLEDGE_TOKEN_BUDGET=6000
# Lowest confidence (0 to 1) a supported hypothesis may have; a lower one is shown as inconclusive. Must stay above the ruled-out ceiling.
INVESTIGATION_SUPPORTED_MINIMUM_CONFIDENCE=0.5
# Highest confidence (0 to 1) a ruled-out hypothesis may have; a higher one is shown as inconclusive.
INVESTIGATION_RULED_OUT_MAXIMUM_CONFIDENCE=0.2
# Evidence checks (1 to 30) one service gets in an investigation; checks beyond it are listed under "what Keigan could not check".
INVESTIGATION_MAX_CHECKS_PER_SERVICE=7
# Characters (1000 to 200000) of one AI call's raw answer kept in an investigation's decision trace; a longer one is cut and marked.
INVESTIGATION_TRACE_RAW_OUTPUT_STORED_CHARACTERS=20000
# Most action items (1 to 20) the AI may propose for one postmortem; a person accepts, edits or discards each.
ACTION_ITEMS_MAXIMUM_PER_POSTMORTEM=8
# Latest due date, in days from today (7 to 730), also the clamp on the AI's suggested number of days.
ACTION_ITEMS_MAXIMUM_DUE_DAYS=180
# Longest details text (200 to 20000 characters) of one action item.
ACTION_ITEMS_DETAILS_MAXIMUM_CHARACTERS=4000
# Shortest reason (1 to 200 characters) required to mark an action item blocked or won't do.
ACTION_ITEMS_REASON_MINIMUM_CHARACTERS=10
# Longest suggested fix command (80 to 4000 characters) shown as copyable; a longer one is withheld.
SUGGESTED_FIX_MAXIMUM_COMMAND_CHARACTERS=600
# Days (7 to 730) after which a runbook that was never used is flagged in the runbook health card.
RUNBOOK_HEALTH_UNUSED_AFTER_DAYS=60
# Days (30 to 1095) without an update after which a runbook is flagged as not updated.
RUNBOOK_HEALTH_STALE_AFTER_DAYS=180
# Fewest rated investigations (1 to 50) before a runbook can be flagged as often rated incorrect.
RUNBOOK_HEALTH_MINIMUM_RATED_INVESTIGATIONS=3
# Share (10 to 100 percent) of its rated investigations that were rated incorrect which flags a runbook.
RUNBOOK_HEALTH_WRONG_SHARE_PERCENT=50.0
# Most overdue and unowned action items (1 to 50) listed in the weekly health review.
WEEKLY_REVIEW_MAXIMUM_LISTED_ITEMS=10
# Share (1 to 100 percent) of an SLO's error budget that one incident may use before the team's policy requires a postmortem with a top-priority prevent item.
ERROR_BUDGET_POLICY_SINGLE_INCIDENT_THRESHOLD_PERCENT=20.0
# Share (1 to 100 percent) of an SLO's error budget that one class of outage (same category and service) may use over the class window.
ERROR_BUDGET_POLICY_OUTAGE_CLASS_THRESHOLD_PERCENT=20.0
# Days (7 up to SLI_RAW_RETENTION_DAYS) of the class window for the outage-class rule, "a quarter".
ERROR_BUDGET_POLICY_OUTAGE_CLASS_WINDOW_DAYS=90
# Minutes (5 to 1440) between re-evaluations of incident budget impacts and policy breaches.
ERROR_BUDGET_POLICY_EVALUATION_INTERVAL_MINUTES=60
# Hours (1 to 168) after resolution when an incident's budget figure becomes final and stops changing.
ERROR_BUDGET_POLICY_FINAL_AFTER_HOURS=24
# Least share (10 to 100 percent) of an SLO's budget window that must have measurements before a budget share is stated.
ERROR_BUDGET_POLICY_MINIMUM_DATA_COVERAGE_PERCENT=50.0
# Fewest events in an SLO's budget window before a budget share is stated (0 to 1000000000).
ERROR_BUDGET_POLICY_MINIMUM_WINDOW_EVENTS=1000
# Start a postmortem draft automatically when a breach is found on a resolved incident (true or false).
ERROR_BUDGET_POLICY_AUTO_DRAFT_POSTMORTEM=true
# Shortest reason (5 to 500 characters) for waiving a policy requirement.
ERROR_BUDGET_POLICY_WAIVER_MINIMUM_CHARACTERS=20
# Longest text (100 to 10000 characters) of what a team does when an SLO's budget is used up.
ERROR_BUDGET_POLICY_GUIDANCE_MAXIMUM_CHARACTERS=2000
# Team roles (comma separated) told about policy breaches in addition to the members subscribed to them.
ERROR_BUDGET_POLICY_NOTIFICATION_ROLES=lead
# Days (90 to 3650) after which closed policy breaches (met, waived or ended) are deleted.
ERROR_BUDGET_POLICY_BREACH_RETENTION_DAYS=730
# Send action item reminder and escalation emails (true or false).
ACTION_ITEMS_REMINDERS_ENABLED=true
# Hour of the day (0 to 23), in each application's time zone, at which the daily reminder job runs.
ACTION_ITEMS_REMINDER_HOUR_LOCAL=9
# Days before the due date of the due-soon reminder (0 to 14; 0 sends none).
ACTION_ITEMS_REMINDER_DAYS_BEFORE_DUE=2
# Days (1 to 30) between reminders for one overdue action item.
ACTION_ITEMS_OVERDUE_REMINDER_INTERVAL_DAYS=7
# Days overdue (1 to 90) after which a top or high priority item is escalated to the escalation roles.
ACTION_ITEMS_ESCALATE_AFTER_OVERDUE_DAYS=14
# Team roles (comma separated) that receive escalations and the items nobody owns.
ACTION_ITEMS_ESCALATION_ROLES=lead,manager
# Days (90 to 3650) after which closed action items (done or won't do) are deleted; open items never expire.
ACTION_ITEMS_CLOSED_RETENTION_DAYS=730
# Accepted shape (a regular expression) of a ServiceNow task number typed on an action item.
ACTION_ITEMS_EXTERNAL_REFERENCE_PATTERN=^[A-Z]{2,10}[0-9]{4,12}$
AUTO_SEND_PRELIMINARY_REPORT=true

# ── Application teams ──────────────────────────────────────────────────────────
# People on an application's team: the most allowed, the minutes between two invitation emails to one person, and the days after which
# an invitation with no sign-in is shown as stale.
TEAM_MEMBERS_MAXIMUM_PER_APPLICATION=100
TEAM_INVITATION_RESEND_COOLDOWN_MINUTES=15
TEAM_INVITATION_STALE_AFTER_DAYS=14

# The longest operating notes an application's team may write for the AI (counted after trimming; 100 to 20000). The notes are guidance for the
# AI's explanations, never evidence, and they are added to every investigation and investigation chat of the application.
APPLICATION_OPERATING_NOTES_MAXIMUM_CHARACTERS=4000

# ── SLO and intelligence ───────────────────────────────────────────────────────
SLI_COLLECTION_INTERVAL_MINUTES=5
# Days of history read when a new SLI is created or accepted (supporting signals such as CPU or restarts need less)
SLO_BACKFILL_DAYS=30
SLO_SUPPORTING_SIGNAL_BACKFILL_DAYS=7
PREDICTIVE_ANALYSIS_INTERVAL_MINUTES=60

# ── Reliability metrics page ───────────────────────────────────────────────────
# Fewest rated investigations before the page shows a "share marked correct" percentage (below it: "not enough ratings yet").
METRICS_MINIMUM_RATING_SAMPLE=5
# Longest period, in days, one request may ask for.
METRICS_MAXIMUM_WINDOW_DAYS=365
# Optional. Per-model prices for an estimated AI cost, as JSON: model name -> price per million input and output tokens (any currency; Keigan only multiplies).
# Empty (the default): the page shows tokens only and says no prices are configured. A model without a price is left out of the estimate and named on the page.
# Example: LLM_MODEL_PRICES_JSON={"gemini-2.5-pro": {"input_per_million": 1.25, "output_per_million": 10}}
LLM_MODEL_PRICES_JSON=

# ── Ask Keigan (the chat that calls Keigan's read-only tools and shows each call). An answer is bounded by its tool-call limit and token budget, not by time.
# Tool calls one answer may make in the Keigan AI chat page (1 to 50); raise it when answers need more lookups.
ASK_KEIGAN_MAX_TOOL_CALLS_GLOBAL=8
# Tool calls one answer may make in an investigation's chat panel (1 to 50).
ASK_KEIGAN_MAX_TOOL_CALLS_INVESTIGATION=6
# Tool requests run from one model turn (1 to 5); the rest are recorded as skipped.
ASK_KEIGAN_MAX_PARALLEL_TOOL_CALLS=3
# Seconds one tool call may take (5 to 600); stops a hung call, never a long answer.
ASK_KEIGAN_TOOL_TIMEOUT_SECONDS=60
# Input plus output tokens across all model turns of one answer (5000 to 1000000); at 85 % the next turn is the last.
ASK_KEIGAN_ANSWER_TOKEN_BUDGET=80000
# Characters of one tool result sent to the model (500 to 50000); not larger than the stored size.
ASK_KEIGAN_TOOL_OUTPUT_MODEL_CHARACTERS=6000
# Characters of one tool result kept as its full output (1000 to 1000000).
ASK_KEIGAN_TOOL_OUTPUT_STORED_CHARACTERS=60000
# Characters of one tool result sent live to the browser (200 to 10000); not larger than the stored size.
ASK_KEIGAN_TOOL_OUTPUT_PREVIEW_CHARACTERS=1500
# Items a list tool returns (1 to 200).
ASK_KEIGAN_TOOL_LIST_ITEM_LIMIT=20
# Points a series tool returns (10 to 1000); the bucket width of a series grows to keep them within it.
ASK_KEIGAN_TOOL_SERIES_POINT_LIMIT=100
# Characters of one passage a tool returns, such as a runbook's steps (200 to 20000); longer text is cut.
ASK_KEIGAN_TOOL_PASSAGE_CHARACTERS=2400
# Longest window, in minutes, a log query tool call may look back (5 to 43200).
ASK_KEIGAN_LOG_QUERY_MAX_LOOKBACK_MINUTES=43200
# Token budget of the knowledge passages one search_knowledge call returns (500 to 20000).
ASK_KEIGAN_KNOWLEDGE_TOKEN_BUDGET=2500
# Newest timeline events in the investigation digest the model starts from (0 to 100).
ASK_KEIGAN_DIGEST_TIMELINE_EVENTS=15
# Topology node names in the investigation digest (0 to 500).
ASK_KEIGAN_DIGEST_TOPOLOGY_NODES=40
# Characters of one evidence summary in the investigation digest (50 to 2000).
ASK_KEIGAN_DIGEST_EVIDENCE_SUMMARY_CHARACTERS=300
# Follow-up question chips shown under an answer (0 to 5).
ASK_KEIGAN_FOLLOW_UP_QUESTION_LIMIT=3
# Repair retries per model turn (0 to 2) for models that use the JSON tool protocol instead of native tool calling.
ASK_KEIGAN_PROTOCOL_REPAIR_ATTEMPTS=1
# Seconds without progress (60 to 3600) after which a running answer counts as interrupted, for example after a pod restart.
ASK_KEIGAN_STALE_RUN_SECONDS=300
# How often a live answer records its progress (5 to 300 s); the stale-run limit must be at least 3 times this.
ASK_KEIGAN_PROGRESS_HEARTBEAT_SECONDS=15
# Seconds between keep-alive comments on the answer stream (5 to 60), for proxies with an idle limit.
ASK_KEIGAN_HEARTBEAT_SECONDS=15
# Events one answer may queue for a slow reader (100 to 100000); when full, the browser reads the stored trace instead.
ASK_KEIGAN_EVENT_QUEUE_SIZE=1000
# Seconds (1 to 120) a stopping API process waits for running answers to end before marking them interrupted.
ASK_KEIGAN_SHUTDOWN_GRACE_SECONDS=10
# Optional: days (30 to 3650) after which stored steps and runs are purged, the answers stay; empty keeps everything.
ASK_KEIGAN_TRACE_RETENTION_DAYS=
# Where the conformance script writes its report and the administration page reads the last one (a file path, relative to the working directory).
ASK_KEIGAN_CONFORMANCE_REPORT_PATH=ask_keigan_conformance_report.json
# Optional JSON overrides of what each model can do (tool calling, streaming, context size); shape in resources/catalogs/llm_model_capabilities.yaml.
LLM_MODEL_CAPABILITIES_JSON={}

# ── Storage and secrets ────────────────────────────────────────────────────────
FILE_STORAGE_MODE=local
AZURE_BLOB_ACCOUNT_URL=
SECRET_STORE_MODE=local_encrypted
AZURE_KEY_VAULT_URL=
# Required (at least SECRET_MINIMUM_LENGTH characters) when SECRET_STORE_MODE=local_encrypted outside ENVIRONMENT=local/test.
# Empty is only accepted locally, where the key then derives from LOCAL_TOKEN_SIGNING_SECRET.
LOCAL_SECRET_ENCRYPTION_KEY=change-me-local-secret-encryption-key
MAX_UPLOAD_BYTES=15728640

# ── Security ───────────────────────────────────────────────────────────────────
PII_MASKING_ENABLED=true
# none | partial | full
PII_MASK_IP_ADDRESSES=partial

# ── Outbound URL policy and telemetry access (keigan/config/telemetry_access_settings.py) ──
# Keigan calls log tool endpoints and synthetic probe URLs only over https and only when the host resolves to a public address.
# Internal hosts Keigan may call anyway (for example an on-premises Splunk), comma separated.
# "splunk.corp.example.com" matches that host, ".corp.example.com" matches its sub-domains.
OUTBOUND_ALLOWED_HOSTS=
# Host names that are always refused, even when listed above (cluster DNS, loopback, cloud metadata).
OUTBOUND_DENIED_HOST_SUFFIXES=localhost,.localhost,.local,.internal,.svc,.cluster.local
# How long a Log Analytics workspace id looked up in Azure is trusted before it is looked up again.
WORKSPACE_IDENTITY_CACHE_SECONDS=900

# ── Job worker and retention (keigan/workers/worker_settings.py) ───────────────
# A running job holds a lease and renews it every JOB_LEASE_RENEWAL_INTERVAL_SECONDS (at most half of the lease), so a long job is never run twice.
# If a worker dies, its job is re-queued once the lease has expired.
JOB_LEASE_DURATION_SECONDS=600
JOB_LEASE_RENEWAL_INTERVAL_SECONDS=120
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
# A handler that runs longer than this is stopped and the job fails, so a hung job cannot hold an investigation slot for ever.
JOB_MAXIMUM_RUNTIME_SECONDS=3600
# Retention cleanup deletes expired incidents and investigations in batches of this many incidents, committing after each batch.
RETENTION_DELETE_BATCH_SIZE=500

# ── AI output and prompt safety ────────────────────────────────────────────────
# Hosts that AI-written text (answers, reports, emails, Teams posts) may link to. Exact host match; "*.example.com" allows sub-domains.
# The hosts of SERVICENOW_INSTANCE_URL, FRONTEND_BASE_URL and PUBLIC_BASE_URL are always allowed too. Every other link becomes plain text.
AI_OUTPUT_ALLOWED_LINK_HOSTS=portal.azure.com,learn.microsoft.com
# Name of your organisation, rendered into prompts ("... SREs at <name>"). Empty = prompts name no organisation.
ORGANIZATION_NAME=
# What to do with an uploaded document that looks like a prompt injection: warn (use it, with a warning in the prompt) | exclude (never use it)
AI_FLAGGED_DOCUMENT_POLICY=warn
# Daily token budget of one user for AI calls that belong to no single application (chat across several applications)
LLM_DAILY_TOKEN_BUDGET_PER_USER=500000
# Earlier chat turns passed to the model, and the characters kept of each turn
CHAT_HISTORY_TURN_LIMIT=8
CHAT_HISTORY_TURN_CHARACTERS=800
