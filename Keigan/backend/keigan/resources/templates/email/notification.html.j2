{% extends "base.html.j2" %}
{% block content %}
{% if facts %}
<tr><td style="padding:8px 24px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
  {% for fact in facts %}
    <tr>
      <td style="padding:6px 8px;border-bottom:1px solid #e6ecf3;font-size:13px;color:#6b7a8c;width:38%;vertical-align:top;">{{ fact.label }}</td>
      <td style="padding:6px 8px;border-bottom:1px solid #e6ecf3;font-size:14px;color:#1d2733;">{{ fact.value }}</td>
    </tr>
  {% endfor %}
  </table>
</td></tr>
{% endif %}
{% if body_html %}
<tr><td style="padding:12px 24px;font-size:14px;line-height:1.6;color:#1d2733;">{{ body_html | safe }}</td></tr>
{% endif %}
{% endblock %}
