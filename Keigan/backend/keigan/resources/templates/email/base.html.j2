<!doctype html>
<html lang="{{ language_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject_line }}</title>
</head>
<body style="margin:0;padding:0;background:#f2f5f9;font-family:'Segoe UI',Arial,'Hiragino Sans','Yu Gothic',sans-serif;color:#1d2733;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f5f9;">
<tr><td align="center" style="padding:24px 12px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #dbe3ec;">
    <tr><td style="background:#0061a0;padding:18px 24px;">
      <span style="color:#ffffff;font-size:20px;font-weight:700;letter-spacing:0.5px;">{{ layout.brand }}</span>
      <span style="color:#a6ce39;font-size:12px;margin-left:10px;">{{ layout.tagline }}</span>
    </td></tr>
    <tr><td style="padding:24px 24px 8px 24px;">
      <h1 style="margin:0 0 8px 0;font-size:20px;line-height:1.3;color:#0061a0;">{{ headline }}</h1>
      <p style="margin:0;font-size:14px;line-height:1.5;color:#44546a;">{{ intro }}</p>
    </td></tr>
    {% block content %}{% endblock %}
    {% if action_url %}
    <tr><td style="padding:8px 24px 24px 24px;">
      <a href="{{ action_url }}" style="display:inline-block;background:#0090da;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;padding:10px 18px;border-radius:6px;">{{ layout.open_in_keigan }}</a>
    </td></tr>
    {% endif %}
    <tr><td style="padding:16px 24px;border-top:1px solid #e6ecf3;background:#f8fafc;font-size:12px;line-height:1.5;color:#6b7a8c;">
      {{ footer }}<br>{{ layout.automated }}
    </td></tr>
  </table>
</td></tr>
</table>
</body>
</html>
